{"id":"msg-1776824811146-mcmpme","type":"tool","content":"File created successfully at: {{SESSION_PATH}}\\data\\create_haier_ppt.py","timestamp":1776824811146,"toolName":"Write","toolUseId":"toolu_27b6ba56e81c491ba2aecbdd","toolInput":{"file_path":"{{SESSION_PATH}}\\data\\create_haier_ppt.py","content":"# -*- coding: utf-8 -*-\n\"\"\"海尔资本组成与关联公司 PPT\"\"\"\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt, Emu\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.text import PP_ALIGN\nfrom pptx.enum.shapes import MSO_SHAPE\nimport os\n\nprs = Presentation()\nprs.slide_width = Inches(13.333)\nprs.slide_height = Inches(7.5)\n\n# === COLORS ===\nHAIER_BLUE = RGBColor(0x00, 0x66, 0xCC)\nDARK_BLUE = RGBColor(0x00, 0x3D, 0x7A)\nDEEP_NAVY = RGBColor(0x0A, 0x1F, 0x3F)\nLIGHT_BLUE = RGBColor(0xD6, 0xE8, 0xF7)\nACCENT_ORANGE = RGBColor(0xFF, 0x8C, 0x00)\nACCENT_GREEN = RGBColor(0x00, 0x96, 0x88)\nACCENT_RED = RGBColor(0xE5, 0x3E, 0x3E)\nWHITE = RGBColor(0xFF, 0xFF, 0xFF)\nDARK_GRAY = RGBColor(0x33, 0x33, 0x33)\nMED_GRAY = RGBColor(0x66, 0x66, 0x66)\nLIGHT_GRAY = RGBColor(0xF5, 0xF7, 0xFA)\nCARD_WHITE = RGBColor(0xFF, 0xFF, 0xFF)\n\ndef add_bg(slide, color):\n    bg = slide.background\n    fill = bg.fill\n    fill.solid()\n    fill.fore_color.rgb = color\n\ndef add_shape(slide, left, top, width, height, fill_color, line_color=None, line_width=None, shape_type=MSO_SHAPE.RECTANGLE):\n    shape = slide.shapes.add_shape(shape_type, left, top, width, height)\n    shape.fill.solid()\n    shape.fill.fore_color.rgb = fill_color\n    if line_color:\n        shape.line.color.rgb = line_color\n        shape.line.width = line_width or Pt(1)\n    else:\n        shape.line.fill.background()\n    return shape\n\ndef add_rounded_rect(slide, left, top, width, height, fill_color, line_color=None):\n    shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, left, top, width, height)\n    shape.fill.solid()\n    shape.fill.fore_color.rgb = fill_color\n    if line_color:\n        shape.line.color.rgb = line_color\n        shape.line.width = Pt(1)\n    else:\n        shape.line.fill.background()\n    return shape\n\ndef add_text_box(slide, left, top, width, height, text, font_size=14, font_color=DARK_GRAY, bold=False, font_face=\"Microsoft YaHei\", alignment=PP_ALIGN.LEFT, line_spacing=None):\n    txBox = slide.shapes.add_textbox(left, top, width, height)\n    tf = txBox.text_frame\n    tf.word_wrap = True\n    p = tf.paragraphs[0]\n    p.text = text\n    p.font.size = Pt(font_size)\n    p.font.color.rgb = font_color\n    p.font.bold = bold\n    p.font.name = font_face\n    p.alignment = alignment\n    if line_spacing:\n        p.space_after = Pt(line_spacing)\n    return txBox\n\ndef add_rich_text_box(slide, left, top, width, height):\n    txBox = slide.shapes.add_textbox(left, top, width, height)\n    tf = txBox.text_frame\n    tf.word_wrap = True\n    return tf\n\ndef add_paragraph(tf, text, font_size=14, font_color=DARK_GRAY, bold=False, font_face=\"Microsoft YaHei\", alignment=PP_ALIGN.LEFT, space_before=0, space_after=4, break_line=True):\n    if len(tf.paragraphs) == 1 and tf.paragraphs[0].text == \"\":\n        p = tf.paragraphs[0]\n    else:\n        p = tf.add_paragraph()\n    p.text = text\n    p.font.size = Pt(font_size)\n    p.font.color.rgb = font_color\n    p.font.bold = bold\n    p.font.name = font_face\n    p.alignment = alignment\n    p.space_before = Pt(space_before)\n    p.space_after = Pt(space_after)\n    return p\n\ndef add_card(slide, left, top, width, height, fill_color=CARD_WHITE, shadow=False, border_color=None):\n    shape = add_rounded_rect(slide, left, top, width, height, fill_color, border_color)\n    if shadow:\n        from pptx.oxml.ns import qn\n        sp = shape._element\n        spPr = sp.find(qn('a:spPr'))\n        if spPr is None:\n            spPr = sp.makeelement(qn('a:spPr'), {})\n            sp.insert(0, spPr)\n        effectLst = spPr.makeelement(qn('a:effectLst'), {})\n        outerShdw = effectLst.makeelement(qn('a:outerShdw'), {\n            'blurRad': '50800', 'dist': '38100', 'dir': '2700000',\n            'algn': 'ctr', 'rotWithShape': '0'\n        })\n        srgbClr = outerShdw.makeelement(qn('a:srgbClr'), {'val': '000000'})\n        alpha = srgbClr.makeelement(qn('a:alpha'), {'val': '12000'})\n        srgbClr.append(alpha)\n        outerShdw.append(srgbClr)\n        effectLst.append(outerShdw)\n        spPr.append(effectLst)\n    return shape\n\n# ============================================\n# SLIDE 1: TITLE\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, DEEP_NAVY)\n\n# Decorative left bar\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\n# Top accent line\nadd_shape(slide, Inches(1.5), Inches(1.2), Inches(3), Inches(0.04), HAIER_BLUE)\n\nadd_text_box(slide, Inches(1.5), Inches(1.5), Inches(9), Inches(1.2),\n    \"海尔集团\", font_size=48, font_color=WHITE, bold=True, font_face=\"Microsoft YaHei\")\n\nadd_text_box(slide, Inches(1.5), Inches(2.7), Inches(9), Inches(1.5),\n    \"资本组成与关联公司全景\", font_size=36, font_color=LIGHT_BLUE, bold=False, font_face=\"Microsoft YaHei\")\n\nadd_text_box(slide, Inches(1.5), Inches(4.5), Inches(9), Inches(0.8),\n    \"HAIER GROUP — Capital Structure & Affiliated Companies\", font_size=18, font_color=MED_GRAY, font_face=\"Microsoft YaHei\")\n\n# Divider\nadd_shape(slide, Inches(1.5), Inches(5.6), Inches(2), Inches(0.03), ACCENT_ORANGE)\n\nadd_text_box(slide, Inches(1.5), Inches(5.9), Inches(5), Inches(0.5),\n    \"报告日期：2026年4月22日\", font_size=14, font_color=MED_GRAY, font_face=\"Microsoft YaHei\")\n\n# Right side decorative\nadd_shape(slide, Inches(11.5), Inches(5.5), Inches(1.5), Inches(0.04), ACCENT_ORANGE)\nadd_shape(slide, Inches(11.5), Inches(5.7), Inches(1), Inches(0.03), HAIER_BLUE)\n\n# ============================================\n# SLIDE 2: 目录\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, LIGHT_GRAY)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_text_box(slide, Inches(0.8), Inches(0.4), Inches(8), Inches(0.8),\n    \"目录\", font_size=36, font_color=DEEP_NAVY, bold=True)\n\nadd_shape(slide, Inches(0.8), Inches(1.3), Inches(2), Inches(0.04), HAIER_BLUE)\n\ntoc_items = [\n    (\"01\", \"集团概况\", \"海尔集团发展历程与核心业务定位\"),\n    (\"02\", \"资本结构\", \"股权架构与控制关系全景\"),\n    (\"03\", \"八大上市公司\", \"海尔系上市公司矩阵详解\"),\n    (\"04\", \"重要关联公司\", \"控股子公司与核心业务平台\"),\n    (\"05\", \"全球化品牌矩阵\", \"海尔品牌生态布局\"),\n    (\"06\", \"重大并购动态\", \"近年核心资本运作事件\"),\n    (\"07\", \"资本平台与激励机制\", \"海创客、海尔国际等核心平台\"),\n]\n\nstart_y = 1.7\nfor i, (num, title, desc) in enumerate(toc_items):\n    y = start_y + i * 0.75\n    # Number circle\n    shape = add_shape(slide, Inches(1.2), Inches(y), Inches(0.5), Inches(0.5), HAIER_BLUE, shape_type=MSO_SHAPE.OVAL)\n    tf = shape.text_frame\n    tf.paragraphs[0].text = num\n    tf.paragraphs[0].font.size = Pt(16)\n    tf.paragraphs[0].font.color.rgb = WHITE\n    tf.paragraphs[0].font.bold = True\n    tf.paragraphs[0].font.name = \"Microsoft YaHei\"\n    tf.paragraphs[0].alignment = PP_ALIGN.CENTER\n\n    add_text_box(slide, Inches(1.9), Inches(y - 0.02), Inches(4), Inches(0.35),\n        title, font_size=18, font_color=DEEP_NAVY, bold=True)\n    add_text_box(slide, Inches(1.9), Inches(y + 0.32), Inches(8), Inches(0.3),\n        desc, font_size=11, font_color=MED_GRAY)\n\n# ============================================\n# SLIDE 3: 集团概况\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, WHITE)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\n# Header bar\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"01  集团概况\", font_size=30, font_color=WHITE, bold=True)\n\n# Left column - overview\nadd_text_box(slide, Inches(0.8), Inches(1.5), Inches(5.5), Inches(0.5),\n    \"海尔集团简介\", font_size=22, font_color=DEEP_NAVY, bold=True)\nadd_shape(slide, Inches(0.8), Inches(2.05), Inches(1.5), Inches(0.03), HAIER_BLUE)\n\ntf = add_rich_text_box(slide, Inches(0.8), Inches(2.2), Inches(5.5), Inches(2.5))\noverview_text = [\n    (\"海尔集团创立于1984年，总部位于山东省青岛市，\", False),\n    (\"是全球领先的美好生活和数字化转型解决方案服务商。\", True),\n    (\"\", False),\n    (\"集团连续15年稳居欧睿国际全球大型家电品牌零售量第一名，\", False),\n    (\"已从传统家电制造商转型为物联网时代的生态品牌。\", True),\n]\nfor text, is_bold in overview_text:\n    add_paragraph(tf, text, font_size=14, font_color=DARK_GRAY, bold=is_bold, space_after=2)\n\n# Right side - key stats\nadd_text_box(slide, Inches(7), Inches(1.5), Inches(5.5), Inches(0.5),\n    \"核心数据\", font_size=22, font_color=DEEP_NAVY, bold=True)\nadd_shape(slide, Inches(7), Inches(2.05), Inches(1.5), Inches(0.03), ACCENT_ORANGE)\n\nstats = [\n    (\"3,023亿\", \"海尔智家2025年营收\", \"首次突破3000亿元\"),\n    (\"195.5亿\", \"归母净利润\", \"同比增长4.39%\"),\n    (\"8家\", \"旗下上市公司数量\", \"总市值超3500亿元\"),\n    (\"7大\", \"全球化高端品牌\", \"海尔/卡萨帝/Leader/GEA等\"),\n    (\"1984年\", \"创立年份\", \"总部位于山东青岛\"),\n]\n\nfor i, (val, label, note) in enumerate(stats):\n    y = 2.3 + i * 0.85\n    # Card\n    add_card(slide, Inches(7), Inches(y), Inches(5.5), Inches(0.72), CARD_WHITE)\n    # Accent bar\n    add_shape(slide, Inches(7), Inches(y), Inches(0.06), Inches(0.72), HAIER_BLUE)\n    # Value\n    add_text_box(slide, Inches(7.25), Inches(y + 0.05), Inches(1.8), Inches(0.4),\n        val, font_size=22, font_color=HAIER_BLUE, bold=True)\n    # Label\n    add_text_box(slide, Inches(9.2), Inches(y + 0.05), Inches(3), Inches(0.35),\n        label, font_size=13, font_color=DEEP_NAVY, bold=True)\n    # Note\n    add_text_box(slide, Inches(9.2), Inches(y + 0.38), Inches(3), Inches(0.3),\n        note, font_size=10, font_color=MED_GRAY)\n\n# Bottom section - business segments\nadd_text_box(slide, Inches(0.8), Inches(5.0), Inches(10), Inches(0.5),\n    \"核心业务板块\", font_size=20, font_color=DEEP_NAVY, bold=True)\n\nbiz_segs = [\n    (\"智慧住居\", \"海尔智家为主体，覆盖冰箱、洗衣机、空调等全品类家电\", HAIER_BLUE),\n    (\"大健康产业\", \"盈康一生生态，涵盖医疗设备、医疗服务、生物制品\", ACCENT_GREEN),\n    (\"工业互联网\", \"卡奥斯COSMOPlat平台，赋能制造业数字化转型\", ACCENT_ORANGE),\n    (\"汽车生态\", \"卡泰驰+汽车之家，布局家车互联与汽车互联网\", ACCENT_RED),\n]\n\nfor i, (title, desc, color) in enumerate(biz_segs):\n    x = 0.8 + i * 3.05\n    # Card\n    add_card(slide, Inches(x), Inches(5.55), Inches(2.8), Inches(1.4), CARD_WHITE)\n    # Top color bar\n    add_shape(slide, Inches(x), Inches(5.55), Inches(2.8), Inches(0.06), color)\n    add_text_box(slide, Inches(x + 0.2), Inches(5.7), Inches(2.4), Inches(0.4),\n        title, font_size=16, font_color=DEEP_NAVY, bold=True)\n    add_text_box(slide, Inches(x + 0.2), Inches(6.1), Inches(2.4), Inches(0.8),\n        desc, font_size=11, font_color=MED_GRAY)\n\n# ============================================\n# SLIDE 4: 资本结构总览\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, LIGHT_GRAY)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"02  资本结构总览\", font_size=30, font_color=WHITE, bold=True)\n\n# Core structure: Haier Group\nadd_card(slide, Inches(4.5), Inches(1.5), Inches(4.3), Inches(0.8), HAIER_BLUE)\nadd_text_box(slide, Inches(4.6), Inches(1.55), Inches(4.1), Inches(0.35),\n    \"海尔集团公司（实控人）\", font_size=18, font_color=WHITE, bold=True, alignment=PP_ALIGN.CENTER)\nadd_text_box(slide, Inches(4.6), Inches(1.9), Inches(4.1), Inches(0.3),\n    \"集体所有制企业 · 核心控制中枢\", font_size=11, font_color=LIGHT_BLUE, alignment=PP_ALIGN.CENTER)\n\n# Arrow down\nadd_shape(slide, Inches(6.4), Inches(2.35), Inches(0.06), Inches(0.4), MED_GRAY)\n\n# Haier International\nadd_card(slide, Inches(3), Inches(2.8), Inches(7.3), Inches(0.7), CARD_WHITE, border_color=HAIER_BLUE)\nadd_text_box(slide, Inches(3.2), Inches(2.85), Inches(3), Inches(0.3),\n    \"海尔电器国际股份有限公司\", font_size=15, font_color=DEEP_NAVY, bold=True)\nadd_text_box(slide, Inches(6.5), Inches(2.85), Inches(3.5), Inches(0.3),\n    \"集团持股51.2% + 海创客48.8%\", font_size=12, font_color=MED_GRAY)\n\n# Arrow down\nadd_shape(slide, Inches(6.4), Inches(3.55), Inches(0.06), Inches(0.35), MED_GRAY)\n\n# Two pillars\nadd_text_box(slide, Inches(0.5), Inches(4.1), Inches(12), Inches(0.5),\n    \"海尔系八大上市公司矩阵\", font_size=22, font_color=DEEP_NAVY, bold=True)\n\n# Listed companies in grid\ncompanies = [\n    (\"海尔智家\", \"600690.SH / 06690.HK\", \"智慧住居·家电\", \"3023亿营收\", HAIER_BLUE),\n    (\"海尔生物\", \"688139.SH\", \"生物医疗低温存储\", \"科创板上市\", ACCENT_GREEN),\n    (\"盈康生命\", \"300143.SZ\", \"医疗服务·肿瘤专科\", \"大健康生态\", ACCENT_RED),\n    (\"上海莱士\", \"002252.SZ\", \"血液制品\", \"血王\", ACCENT_ORANGE),\n    (\"雷神科技\", \"872190.BJ\", \"电竞硬件·笔记本\", \"北交所上市\", HAIER_BLUE),\n    (\"新时达\", \"002527.SZ\", \"工业机器人\", \"卡奥斯控股\", DEEP_NAVY),\n    (\"汽车之家\", \"02518.HK\", \"汽车互联网平台\", \"卡泰驰控股\", ACCENT_RED),\n    (\"众淼控股\", \"A股\", \"综合控股平台\", \"海尔系成员\", MED_GRAY),\n]\n\nfor i, (name, code, biz, tag, color) in enumerate(companies):\n    col = i % 4\n    row = i // 4\n    x = 0.5 + col * 3.15\n    y = 4.7 + row * 1.35\n\n    add_card(slide, Inches(x), Inches(y), Inches(2.95), Inches(1.15), CARD_WHITE)\n    # Left accent\n    add_shape(slide, Inches(x), Inches(y), Inches(0.06), Inches(1.15), color)\n    # Name\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.08), Inches(2.5), Inches(0.3),\n        name, font_size=16, font_color=DEEP_NAVY, bold=True)\n    # Code\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.38), Inches(2.5), Inches(0.25),\n        code, font_size=10, font_color=MED_GRAY)\n    # Biz\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.6), Inches(2.5), Inches(0.25),\n        biz, font_size=11, font_color=DARK_GRAY)\n    # Tag\n    tag_shape = add_rounded_rect(slide, Inches(x + 0.2), Inches(y + 0.85), Inches(1.2), Inches(0.22), color)\n    tf = tag_shape.text_frame\n    tf.paragraphs[0].text = tag\n    tf.paragraphs[0].font.size = Pt(9)\n    tf.paragraphs[0].font.color.rgb = WHITE\n    tf.paragraphs[0].font.bold = True\n    tf.paragraphs[0].font.name = \"Microsoft YaHei\"\n    tf.paragraphs[0].alignment = PP_ALIGN.CENTER\n\n# ============================================\n# SLIDE 5: 股权结构详解\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, WHITE)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"02  股权结构详解\", font_size=30, font_color=WHITE, bold=True)\n\n# Haier Group ownership structure\nadd_text_box(slide, Inches(0.8), Inches(1.4), Inches(10), Inches(0.5),\n    \"海尔集团公司 — 最终实控人\", font_size=22, font_color=DEEP_NAVY, bold=True)\nadd_shape(slide, Inches(0.8), Inches(1.9), Inches(1.5), Inches(0.03), HAIER_BLUE)\n\ntf = add_rich_text_box(slide, Inches(0.8), Inches(2.05), Inches(5.5), Inches(2))\nadd_paragraph(tf, \"海尔集团公司为集体所有制企业，通过海尔国际等控股平台对旗下上市公司进行实际控制。\", font_size=13, space_after=4)\nadd_paragraph(tf, \"关键控制链：\", font_size=14, bold=True, space_before=6, space_after=4)\nadd_paragraph(tf, \"海尔集团公司 → 海尔国际(51.2%) → 各业务板块\", font_size=12, font_color=HAIER_BLUE, space_after=2)\nadd_paragraph(tf, \"海创客(职工持股平台) → 海尔国际(48.8%，表决权委托给海尔集团)\", font_size=12, font_color=MED_GRAY, space_after=2)\n\n# Haier Smart Home shareholder structure\nadd_text_box(slide, Inches(7), Inches(1.4), Inches(5.5), Inches(0.5),\n    \"海尔智家十大股东（2025）\", font_size=20, font_color=DEEP_NAVY, bold=True)\nadd_shape(slide, Inches(7), Inches(1.9), Inches(1.5), Inches(0.03), ACCENT_ORANGE)\n\n# Table\ntable_data = [\n    [\"股东名称\", \"持股比例\", \"性质\"],\n    [\"HKSCC NOMINEES LIMITED\", \"24.5%\", \"港股通代持\"],\n    [\"海尔卡奥斯\", \"13%\", \"集团控股平台\"],\n    [\"海尔集团公司（张瑞敏）\", \"11%\", \"创始团队\"],\n    [\"香港中央结算公司\", \"7%\", \"港股通\"],\n    [\"HCH（海尔旗下）\", \"5%\", \"集团关联\"],\n    [\"中国证券金融\", \"—\", \"国家队\"],\n    [\"中国工商银行\", \"—\", \"机构\"],\n    [\"中央汇金资管\", \"—\", \"国家队\"],\n]\n\ntable = slide.shapes.add_table(len(table_data), 3, Inches(7), Inches(2.15), Inches(5.5), Inches(3.2)).table\ntable.columns[0].width = Inches(2.8)\ntable.columns[1].width = Inches(1.2)\ntable.columns[2].width = Inches(1.5)\n\nfor r, row_data in enumerate(table_data):\n    for c, cell_text in enumerate(row_data):\n        cell = table.cell(r, c)\n        cell.text = cell_text\n        for paragraph in cell.text_frame.paragraphs:\n            paragraph.font.size = Pt(11)\n            paragraph.font.name = \"Microsoft YaHei\"\n            paragraph.font.color.rgb = WHITE if r == 0 else DARK_GRAY\n            paragraph.font.bold = (r == 0)\n            paragraph.alignment = PP_ALIGN.CENTER if c > 0 else PP_ALIGN.LEFT\n        if r == 0:\n            cell.fill.solid()\n            cell.fill.fore_color.rgb = DEEP_NAVY\n        else:\n            cell.fill.solid()\n            cell.fill.fore_color.rgb = LIGHT_GRAY if r % 2 == 0 else WHITE\n\n# Bottom note\nadd_card(slide, Inches(0.8), Inches(4.5), Inches(11.7), Inches(2.5), LIGHT_GRAY)\nadd_text_box(slide, Inches(1), Inches(4.6), Inches(11), Inches(0.4),\n    \"海尔资本结构核心特征\", font_size=18, font_color=DEEP_NAVY, bold=True)\n\nfeatures = [\n    \"集体所有制性质：海尔集团非民营控股也非国有独资，属于集体所有制企业，这一独特性质使其兼具市场化灵活性与公共属性\",\n    \"职工持股平台（海创客）：由张瑞敏等67名高管合伙人带领组建的全员持股平台，将所持海尔国际股权的表决权全部委托给海尔集团行使\",\n    \"多层控股架构：通过海尔国际、海尔卡泰驰、卡奥斯等控股平台间接控制各上市公司，形成'集团→控股平台→上市公司'三级架构\",\n    \"国家资本参与：中国证券金融、中央汇金等国家队资金持有海尔智家股份，体现国家资本对海尔的认可\",\n]\n\nfor i, feat in enumerate(features):\n    y = 5.05 + i * 0.5\n    # Number dot\n    dot = add_shape(slide, Inches(1.1), Inches(y + 0.05), Inches(0.25), Inches(0.25), HAIER_BLUE, shape_type=MSO_SHAPE.OVAL)\n    dot.text_frame.paragraphs[0].text = str(i + 1)\n    dot.text_frame.paragraphs[0].font.size = Pt(10)\n    dot.text_frame.paragraphs[0].font.color.rgb = WHITE\n    dot.text_frame.paragraphs[0].font.bold = True\n    dot.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER\n    add_text_box(slide, Inches(1.5), Inches(y), Inches(10.5), Inches(0.35),\n        feat, font_size=11, font_color=DARK_GRAY)\n\n# ============================================\n# SLIDE 6: 八大上市公司详解(上)\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, LIGHT_GRAY)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"03  八大上市公司详解（上）\", font_size=30, font_color=WHITE, bold=True)\n\n# Four detailed cards\ndetails = [\n    {\n        \"name\": \"海尔智家\", \"code\": \"600690.SH / 06690.HK / 690D.DE\",\n        \"color\": HAIER_BLUE,\n        \"desc\": \"集团核心上市主体，全球大型家电第一品牌\",\n        \"items\": [\n            \"2025年营收3,023亿元，首次突破3000亿大关\",\n            \"归母净利润195.53亿元，同比增长4.39%\",\n            \"资产负债率56.48%，经营现金流260亿元\",\n            \"旗下品牌：海尔、卡萨帝、Leader、GE Appliances、Fisher & Paykel、AQUA、CANDY\",\n            \"入选《财富》世界500强\"\n        ]\n    },\n    {\n        \"name\": \"海尔生物\", \"code\": \"688139.SH\",\n        \"color\": ACCENT_GREEN,\n        \"desc\": \"科创板首批上市企业，生物医疗低温存储龙头\",\n        \"items\": [\n            \"控股股东：海尔生物医疗控股有限公司(31.73%)\",\n            \"海创睿（创客激励平台）持股10.13%\",\n            \"实际控制人：海尔集团公司\",\n            \"主营：生物样本库、疫苗冷藏、血液安全等低温存储解决方案\"\n        ]\n    },\n    {\n        \"name\": \"盈康生命\", \"code\": \"300143.SZ\",\n        \"color\": ACCENT_RED,\n        \"desc\": \"大健康产业生态平台，前身为星普医科\",\n        \"items\": [\n            \"2019年海尔以18.23亿元入主，实控人变更为海尔集团\",\n            \"控股股东：盈康双生（重庆）科技有限公司（海尔国际全资子公司）\",\n            \"聚焦肿瘤专科服务网络，拥有伽玛刀等核心设备\",\n            \"2023年营业收入同比增长27.2%\"\n        ]\n    },\n    {\n        \"name\": \"上海莱士\", \"code\": \"002252.SZ\",\n        \"color\": ACCENT_ORANGE,\n        \"desc\": \"国内血液制品龙头企业，被称为'血王'\",\n        \"items\": [\n            \"海尔集团收购成为重要股东\",\n            \"主营：血液制品的研发、生产和销售\",\n            \"与海尔生物形成大健康板块协同效应\"\n        ]\n    },\n]\n\nfor i, d in enumerate(details):\n    col = i % 2\n    row = i // 2\n    x = 0.5 + col * 6.35\n    y = 1.35 + row * 3.05\n\n    add_card(slide, Inches(x), Inches(y), Inches(6.1), Inches(2.8), CARD_WHITE)\n    # Header\n    add_shape(slide, Inches(x), Inches(y), Inches(6.1), Inches(0.06), d[\"color\"])\n    add_text_box(slide, Inches(x + 0.25), Inches(y + 0.15), Inches(3), Inches(0.35),\n        d[\"name\"], font_size=20, font_color=DEEP_NAVY, bold=True)\n    add_text_box(slide, Inches(x + 0.25), Inches(y + 0.5), Inches(3.5), Inches(0.25),\n        d[\"code\"], font_size=10, font_color=MED_GRAY)\n\n    # Description\n    add_text_box(slide, Inches(x + 0.25), Inches(y + 0.8), Inches(5.5), Inches(0.3),\n        d[\"desc\"], font_size=12, font_color=HAIER_BLUE, bold=True)\n\n    # Items\n    for j, item in enumerate(d[\"items\"]):\n        add_text_box(slide, Inches(x + 0.35), Inches(y + 1.15 + j * 0.32), Inches(5.5), Inches(0.3),\n            f\"▸ {item}\", font_size=10, font_color=DARK_GRAY)\n\n# ============================================\n# SLIDE 7: 八大上市公司详解(下)\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, WHITE)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"03  八大上市公司详解（下）\", font_size=30, font_color=WHITE, bold=True)\n\ndetails2 = [\n    {\n        \"name\": \"雷神科技\", \"code\": \"872190.BJ\",\n        \"color\": HAIER_BLUE,\n        \"desc\": \"电竞硬件品牌，北交所上市公司\",\n        \"items\": [\n            \"主营电竞笔记本、显示器、外设等硬件产品\",\n            \"海尔系在工业互联网和消费电子之外的科技延伸\",\n            \"2023年境外主营业务再创新高\"\n        ]\n    },\n    {\n        \"name\": \"新时达\", \"code\": \"002527.SZ\",\n        \"color\": DEEP_NAVY,\n        \"desc\": \"工业机器人龙头企业，2025年被海尔收购\",\n        \"items\": [\n            \"海尔卡奥斯工业智能以13亿元收购10%股权+19.24%表决权委托\",\n            \"斥资超12亿元包揽定增，持股达26.83%\",\n            \"海尔集团成为实际控制人\",\n            \"全球领先的机器人本体及运动控制解决方案提供商\"\n        ]\n    },\n    {\n        \"name\": \"汽车之家\", \"code\": \"02518.HK / ATHM.N\",\n        \"color\": ACCENT_RED,\n        \"desc\": \"中国汽车互联网平台龙头，2025年海尔入主\",\n        \"items\": [\n            \"卡泰驰控股以约18亿美元收购41.91%股份\",\n            \"交易完成后卡泰驰成为控股股东，平安保留约4.99%\",\n            \"月活跃用户峰值超6400万\",\n            \"覆盖媒体服务、交易服务、数据服务、金融服务等领域\",\n            \"2024年净利润16.81亿元\"\n        ]\n    },\n    {\n        \"name\": \"众淼控股\", \"code\": \"A股\",\n        \"color\": MED_GRAY,\n        \"desc\": \"综合控股平台，海尔系成员企业\",\n        \"items\": [\n            \"海尔集团资本版图的重要组成\",\n            \"作为综合控股平台承载非核心业务资产\"\n        ]\n    },\n]\n\nfor i, d in enumerate(details2):\n    col = i % 2\n    row = i // 2\n    x = 0.5 + col * 6.35\n    y = 1.35 + row * 3.05\n\n    add_card(slide, Inches(x), Inches(y), Inches(6.1), Inches(2.8), CARD_WHITE)\n    add_shape(slide, Inches(x), Inches(y), Inches(6.1), Inches(0.06), d[\"color\"])\n    add_text_box(slide, Inches(x + 0.25), Inches(y + 0.15), Inches(3), Inches(0.35),\n        d[\"name\"], font_size=20, font_color=DEEP_NAVY, bold=True)\n    add_text_box(slide, Inches(x + 0.25), Inches(y + 0.5), Inches(3.5), Inches(0.25),\n        d[\"code\"], font_size=10, font_color=MED_GRAY)\n    add_text_box(slide, Inches(x + 0.25), Inches(y + 0.8), Inches(5.5), Inches(0.3),\n        d[\"desc\"], font_size=12, font_color=HAIER_BLUE, bold=True)\n\n    for j, item in enumerate(d[\"items\"]):\n        add_text_box(slide, Inches(x + 0.35), Inches(y + 1.15 + j * 0.32), Inches(5.5), Inches(0.3),\n            f\"▸ {item}\", font_size=10, font_color=DARK_GRAY)\n\n# ============================================\n# SLIDE 8: 重要关联公司\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, LIGHT_GRAY)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"04  重要关联公司与业务平台\", font_size=30, font_color=WHITE, bold=True)\n\naffiliates = [\n    (\"海尔卡奥斯\", \"Cosmoplat\", \"工业互联网平台\", \"中国领先的工业数智化产品与服务商，已递表港交所申请IPO，拟筹资约5亿美元。为制造业、电子、纺织等行业提供端到端数字化解决方案。\", HAIER_BLUE),\n    (\"卡泰驰控股\", \"CARTECH\", \"汽车生态平台\", \"海尔集团子公司，拥有汽车高端定制、智慧充电、家车互联、二手车交易四大业务。控股汽车之家并布局汽车产业生态。\", ACCENT_RED),\n    (\"日日顺物流\", \"RRS\", \"智慧物流\", \"海尔旗下物流平台，覆盖全国城乡配送网络，曾计划创业板IPO（2024年10月终止）。承载集团物流及供应链核心能力。\", ACCENT_GREEN),\n    (\"海尔消费金融\", \"Haier Consumer Finance\", \"消费金融服务\", \"海尔集团持股49%（第一大股东），全国性消费金融公司。注册资本20.9亿元，由产业发起设立的产融结合消费金融平台。\", ACCENT_ORANGE),\n    (\"海尔集团财务公司\", \"Haier Finance\", \"集团财务公司\", \"注册资本100亿元（2025年增至），由海尔集团公司等共同持股，为集团成员单位提供资金管理和金融服务。\", DEEP_NAVY),\n    (\"青岛海有蓝控股\", \"Haiyoulan\", \"投资控股平台\", \"海尔集团全资子公司，注册资本15亿元。下设海盈康医疗科技（注册资本60亿元），涉足物联网、企业总部管理、投资活动等。\", MED_GRAY),\n]\n\nfor i, (name, eng, tag, desc, color) in enumerate(affiliates):\n    col = i % 3\n    row = i // 3\n    x = 0.5 + col * 4.15\n    y = 1.35 + row * 3.05\n\n    add_card(slide, Inches(x), Inches(y), Inches(3.9), Inches(2.8), CARD_WHITE)\n    # Color header\n    add_shape(slide, Inches(x), Inches(y), Inches(3.9), Inches(0.06), color)\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.12), Inches(3.5), Inches(0.35),\n        name, font_size=17, font_color=DEEP_NAVY, bold=True)\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.45), Inches(3.5), Inches(0.25),\n        eng, font_size=10, font_color=MED_GRAY)\n    # Tag\n    tag_shape = add_rounded_rect(slide, Inches(x + 0.2), Inches(y + 0.72), Inches(1.2), Inches(0.22), color)\n    tag_shape.text_frame.paragraphs[0].text = tag\n    tag_shape.text_frame.paragraphs[0].font.size = Pt(9)\n    tag_shape.text_frame.paragraphs[0].font.color.rgb = WHITE\n    tag_shape.text_frame.paragraphs[0].font.bold = True\n    tag_shape.text_frame.paragraphs[0].font.name = \"Microsoft YaHei\"\n    tag_shape.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER\n    # Desc\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 1.05), Inches(3.5), Inches(1.6),\n        desc, font_size=11, font_color=DARK_GRAY)\n\n# ============================================\n# SLIDE 9: 全球化品牌矩阵\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, WHITE)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"05  全球化品牌矩阵\", font_size=30, font_color=WHITE, bold=True)\n\nadd_text_box(slide, Inches(0.8), Inches(1.4), Inches(10), Inches(0.5),\n    \"海尔全球化高端品牌矩阵\", font_size=24, font_color=DEEP_NAVY, bold=True)\nadd_shape(slide, Inches(0.8), Inches(1.9), Inches(2), Inches(0.03), HAIER_BLUE)\n\nadd_text_box(slide, Inches(0.8), Inches(2.05), Inches(6), Inches(0.8),\n    \"海尔构建了覆盖全球主要市场的品牌矩阵，从大众到高端，从中国到全球，实现全品类、全价格段、全区域覆盖。\",\n    font_size=13, font_color=DARK_GRAY)\n\nbrands = [\n    (\"海尔 Haier\", \"主品牌·全球第一\", \"全球大型家电销量第一，连续15年欧睿国际排名榜首\", HAIER_BLUE),\n    (\"卡萨帝 Casarte\", \"高端品牌\", \"定位于高端家电市场，主打艺术化设计与品质生活\", DEEP_NAVY),\n    (\"Leader\", \"年轻品牌\", \"面向年轻消费群体的定制化互联网家电品牌\", ACCENT_ORANGE),\n    (\"GE Appliances\", \"北美市场\", \"美国通用电气家电业务，北美市场主力品牌\", ACCENT_RED),\n    (\"Fisher & Paykel\", \"大洋洲市场\", \"新西兰顶级家电品牌，大洋洲市场领导地位\", ACCENT_GREEN),\n    (\"AQUA\", \"日本市场\", \"源自三洋电机，日本市场核心品牌\", HAIER_BLUE),\n    (\"CANDY\", \"欧洲市场\", \"意大利家电品牌，补充海尔在欧洲的品牌布局\", MED_GRAY),\n]\n\nfor i, (name, pos, desc, color) in enumerate(brands):\n    col = i % 4\n    row = i // 4\n    x = 0.5 + col * 3.15\n    y = 3.0 + row * 2.2\n\n    add_card(slide, Inches(x), Inches(y), Inches(2.95), Inches(1.9), CARD_WHITE)\n    add_shape(slide, Inches(x), Inches(y), Inches(2.95), Inches(0.06), color)\n    # Brand name\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.15), Inches(2.5), Inches(0.4),\n        name, font_size=18, font_color=DEEP_NAVY, bold=True)\n    # Position\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.55), Inches(2.5), Inches(0.3),\n        pos, font_size=12, font_color=color, bold=True)\n    # Desc\n    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.9), Inches(2.5), Inches(0.9),\n        desc, font_size=11, font_color=DARK_GRAY)\n\n# Footer highlight\nadd_card(slide, Inches(0.5), Inches(5.4), Inches(12.3), Inches(1.6), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(5.5), Inches(11), Inches(0.5),\n    \"全球第一\", font_size=32, font_color=WHITE, bold=True)\nadd_text_box(slide, Inches(0.8), Inches(6.05), Inches(11), Inches(0.5),\n    \"连续15年稳居「欧睿国际全球大型家电品牌零售量」第一名\", font_size=16, font_color=LIGHT_BLUE)\nadd_text_box(slide, Inches(8), Inches(5.5), Inches(4.5), Inches(1.2),\n    \"全球布局：中国 · 北美 · 欧洲 · 日本 · 大洋洲\\n7大品牌覆盖全球主要家电市场\\n2025年海尔智家营收突破3,023亿元\",\n    font_size=12, font_color=LIGHT_BLUE, alignment=PP_ALIGN.RIGHT)\n\n# ============================================\n# SLIDE 10: 重大并购动态\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, LIGHT_GRAY)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"06  重大并购动态\", font_size=30, font_color=WHITE, bold=True)\n\n# Timeline style\nmergers = [\n    (\"2019\", \"入主盈康生命\", \"以18.23亿元收购星普医科（后更名盈康生命），实控人变更为海尔集团，进军大健康领域。\", HAIER_BLUE),\n    (\"2019\", \"海尔生物科创板上市\", \"海尔生物医疗在沪交所挂牌，首日大涨96%，成为'青岛科创第一股'。\", ACCENT_GREEN),\n    (\"2023-2024\", \"收购开利商用制冷\", \"出手收购开利集团商用制冷业务，进一步扩展全球制冷产业链布局。\", HAIER_BLUE),\n    (\"2024\", \"入主上海莱士\", \"收购血液制品龙头上海莱士，被市场称为'血王'，强化大健康生态版图。\", ACCENT_ORANGE),\n    (\"2025.02\", \"收购新时达\", \"卡奥斯以13亿收购10%股权+表决权委托+定增，成为工业机器人龙头实控人。\", DEEP_NAVY),\n    (\"2025.02\", \"控股汽车之家\", \"卡泰驰以约18亿美元收购41.91%股份，成为中国最大汽车互联网平台控股股东。\", ACCENT_RED),\n]\n\nfor i, (date, title, desc, color) in enumerate(mergers):\n    y = 1.35 + i * 0.95\n\n    # Timeline dot\n    dot = add_shape(slide, Inches(1.2), Inches(y + 0.15), Inches(0.35), Inches(0.35), color, shape_type=MSO_SHAPE.OVAL)\n    dot.text_frame.paragraphs[0].text = date[-2:] if len(date) > 4 else date\n    dot.text_frame.paragraphs[0].font.size = Pt(9)\n    dot.text_frame.paragraphs[0].font.color.rgb = WHITE\n    dot.text_frame.paragraphs[0].font.bold = True\n    dot.text_frame.paragraphs[0].font.name = \"Microsoft YaHei\"\n    dot.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER\n\n    # Timeline line\n    if i < len(mergers) - 1:\n        add_shape(slide, Inches(1.35), Inches(y + 0.5), Inches(0.03), Inches(0.95), MED_GRAY)\n\n    # Card\n    add_card(slide, Inches(1.8), Inches(y), Inches(10.8), Inches(0.82), CARD_WHITE)\n    # Date\n    add_text_box(slide, Inches(2), Inches(y + 0.05), Inches(1.2), Inches(0.3),\n        date, font_size=13, font_color=color, bold=True)\n    # Title\n    add_text_box(slide, Inches(3.2), Inches(y + 0.05), Inches(3), Inches(0.3),\n        title, font_size=15, font_color=DEEP_NAVY, bold=True)\n    # Desc\n    add_text_box(slide, Inches(3.2), Inches(y + 0.38), Inches(9), Inches(0.4),\n        desc, font_size=10, font_color=MED_GRAY)\n\n# Summary\nadd_card(slide, Inches(1.8), Inches(7.0), Inches(10.8), Inches(0.0), CARD_WHITE)\n\n# ============================================\n# SLIDE 11: 资本平台与激励机制\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, WHITE)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\nadd_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n    \"07  资本平台与激励机制\", font_size=30, font_color=WHITE, bold=True)\n\n# Haier International\nadd_text_box(slide, Inches(0.8), Inches(1.4), Inches(10), Inches(0.5),\n    \"海尔国际 — 资本运作核心平台\", font_size=22, font_color=DEEP_NAVY, bold=True)\nadd_shape(slide, Inches(0.8), Inches(1.9), Inches(1.5), Inches(0.03), HAIER_BLUE)\n\nadd_card(slide, Inches(0.8), Inches(2.1), Inches(5.5), Inches(2.2), CARD_WHITE)\nadd_text_box(slide, Inches(1), Inches(2.2), Inches(5), Inches(0.3),\n    \"海尔电器国际股份有限公司\", font_size=17, font_color=DEEP_NAVY, bold=True)\n\ntf = add_rich_text_box(slide, Inches(1), Inches(2.55), Inches(5), Inches(1.6))\nitems = [\n    \"前身为青岛海尔洗衣机股份公司（1997年更名）\",\n    \"海尔集团公司持股51.2%，海创客持股48.8%\",\n    \"持有非白电业务主要资产：生物医疗、日日顺物流等\",\n    \"海创客已将全部表决权委托给海尔集团行使\",\n    \"是海尔资本运作主体，控股多家上市公司\",\n    \"通过全资子公司控股：海尔生物医疗控股、盈康双生等\",\n]\nfor item in items:\n    add_paragraph(tf, f\"▸ {item}\", font_size=11, space_after=3)\n\n# Haier International structure visual\nadd_card(slide, Inches(6.8), Inches(2.1), Inches(5.8), Inches(2.2), LIGHT_GRAY)\nadd_text_box(slide, Inches(7), Inches(2.2), Inches(5), Inches(0.3),\n    \"海尔国际股权穿透图\", font_size=16, font_color=DEEP_NAVY, bold=True)\n\n# Visual tree\n# Top: Haier Group\nhg = add_rounded_rect(slide, Inches(8), Inches(2.7), Inches(2), Inches(0.45), HAIER_BLUE)\nhg.text_frame.paragraphs[0].text = \"海尔集团公司 51.2%\"\nhg.text_frame.paragraphs[0].font.size = Pt(12)\nhg.text_frame.paragraphs[0].font.color.rgb = WHITE\nhg.text_frame.paragraphs[0].font.bold = True\nhg.text_frame.paragraphs[0].font.name = \"Microsoft YaHei\"\nhg.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER\n\nhc = add_rounded_rect(slide, Inches(10.3), Inches(2.7), Inches(1.8), Inches(0.45), MED_GRAY)\nhc.text_frame.paragraphs[0].text = \"海创客 48.8%\"\nhc.text_frame.paragraphs[0].font.size = Pt(12)\nhc.text_frame.paragraphs[0].font.color.rgb = WHITE\nhc.text_frame.paragraphs[0].font.bold = True\nhc.text_frame.paragraphs[0].font.name = \"Microsoft YaHei\"\nhc.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER\n\n# Arrow\nadd_shape(slide, Inches(9.1), Inches(3.18), Inches(0.04), Inches(0.25), MED_GRAY)\n\n# Haier International\nhi = add_rounded_rect(slide, Inches(7.8), Inches(3.45), Inches(3), Inches(0.45), DEEP_NAVY)\nhi.text_frame.paragraphs[0].text = \"海尔国际（全资控股平台）\"\nhi.text_frame.paragraphs[0].font.size = Pt(12)\nhi.text_frame.paragraphs[0].font.color.rgb = WHITE\nhi.text_frame.paragraphs[0].font.bold = True\nhi.text_frame.paragraphs[0].font.name = \"Microsoft YaHei\"\nhi.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER\n\n# Subsidiaries\nsubs = [(\"海尔生物医疗控股\", \"→ 海尔生物\"), (\"盈康双生(重庆)\", \"→ 盈康生命\"), (\"日日顺物流\", \"物流板块\")]\nfor i, (sub, arrow) in enumerate(subs):\n    x = 7.1 + i * 1.9\n    add_shape(slide, Inches(x + 0.7), Inches(3.93), Inches(0.03), Inches(0.2), MED_GRAY)\n    sc = add_rounded_rect(slide, Inches(x), Inches(4.15), Inches(1.7), Inches(0.35), LIGHT_BLUE)\n    sc.text_frame.paragraphs[0].text = sub\n    sc.text_frame.paragraphs[0].font.size = Pt(10)\n    sc.text_frame.paragraphs[0].font.color.rgb = DEEP_NAVY\n    sc.text_frame.paragraphs[0].font.bold = True\n    sc.text_frame.paragraphs[0].font.name = \"Microsoft YaHei\"\n    sc.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER\n\n# Employee incentive\nadd_text_box(slide, Inches(0.8), Inches(4.7), Inches(10), Inches(0.5),\n    \"海创客 — 全员持股激励平台\", font_size=22, font_color=DEEP_NAVY, bold=True)\nadd_shape(slide, Inches(0.8), Inches(5.2), Inches(1.5), Inches(0.03), ACCENT_ORANGE)\n\nadd_card(slide, Inches(0.8), Inches(5.35), Inches(11.7), Inches(1.6), LIGHT_GRAY)\n\ntf = add_rich_text_box(slide, Inches(1), Inches(5.45), Inches(11), Inches(1.4))\nadd_paragraph(tf, \"海创客（青岛海创客管理咨询企业）\", font_size=15, font_color=DEEP_NAVY, bold=True, space_after=4)\nadd_paragraph(tf, \"海创客由海尔内部职工持股会变更而来，是海尔全员持股的核心激励平台。由张瑞敏等67名高管合伙人带领组建，持有海尔国际48.8%的股权，但已将所持有股权对应的全部表决权委托给海尔集团行使。\", font_size=12, space_after=4)\nadd_paragraph(tf, \"创客激励体系：\", font_size=13, font_color=HAIER_BLUE, bold=True, space_before=4, space_after=4)\nadd_paragraph(tf, \"海创睿等创客激励平台持有海尔生物等上市公司股权，形成'集团—创客平台—上市公司'的股权激励闭环，充分激发内部创新动力。\", font_size=12)\n\n# ============================================\n# SLIDE 12: END\n# ============================================\nslide = prs.slides.add_slide()\nadd_bg(slide, DEEP_NAVY)\nadd_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n\nadd_shape(slide, Inches(1.5), Inches(2.0), Inches(2), Inches(0.04), HAIER_BLUE)\n\nadd_text_box(slide, Inches(1.5), Inches(2.3), Inches(9), Inches(1),\n    \"感谢观看\", font_size=44, font_color=WHITE, bold=True)\n\nadd_text_box(slide, Inches(1.5), Inches(3.4), Inches(9), Inches(0.8),\n    \"海尔集团 · 资本组成与关联公司全景\", font_size=22, font_color=LIGHT_BLUE)\n\nadd_text_box(slide, Inches(1.5), Inches(4.2), Inches(9), Inches(0.5),\n    \"数据来源：公开信息整理，仅供参考，不构成投资建议\", font_size=12, font_color=MED_GRAY)\n\nadd_shape(slide, Inches(1.5), Inches(5.0), Inches(2), Inches(0.03), ACCENT_ORANGE)\n\n# Key summary\nsummary_items = [\n    \"8家上市公司 · 总市值超3500亿元\",\n    \"7大全球化品牌 · 连续15年全球第一\",\n    \"4大核心业务板块 · 智慧住居/大健康/工业互联网/汽车生态\",\n]\nfor i, item in enumerate(summary_items):\n    add_text_box(slide, Inches(1.5), Inches(5.3 + i * 0.4), Inches(10), Inches(0.35),\n        item, font_size=14, font_color=LIGHT_BLUE)\n\n# Save\noutput_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"海尔资本组成与关联公司.pptx\")\nprs.save(output_path)\nprint(f\"PPT saved to: {output_path}\")\n"},"toolResult":"File created successfully at: {{SESSION_PATH}}\\data\\create_haier_ppt.py","toolStatus":"completed","toolDisplayMeta":{"displayName":"写入","category":"native"},"isError":false,"turnId":"msg_982e235c-5a24-42ba-bd80-c31d52536b8e"}
