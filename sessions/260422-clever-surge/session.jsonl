rame\n   332→    tf.paragraphs[0].text = tag\n   333→    tf.paragraphs[0].font.size = Pt(9)\n   334→    tf.paragraphs[0].font.color.rgb = WHITE\n   335→    tf.paragraphs[0].font.bold = True\n   336→    tf.paragraphs[0].font.name = \"Microsoft YaHei\"\n   337→    tf.paragraphs[0].alignment = PP_ALIGN.CENTER\n   338→\n   339→# ============================================\n   340→# SLIDE 5: 股权结构详解\n   341→# ============================================\n   342→slide = prs.slides.add_slide(prs.slide_layouts[6])  # Blank layout\n   343→add_bg(slide, WHITE)\n   344→add_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n   345→\n   346→add_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\n   347→add_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n   348→    \"02  股权结构详解\", font_size=30, font_color=WHITE, bold=True)\n   349→\n   350→# Haier Group ownership structure\n   351→add_text_box(slide, Inches(0.8), Inches(1.4), Inches(10), Inches(0.5),\n   352→    \"海尔集团公司 — 最终实控人\", font_size=22, font_color=DEEP_NAVY, bold=True)\n   353→add_shape(slide, Inches(0.8), Inches(1.9), Inches(1.5), Inches(0.03), HAIER_BLUE)\n   354→\n   355→tf = add_rich_text_box(slide, Inches(0.8), Inches(2.05), Inches(5.5), Inches(2))\n   356→add_paragraph(tf, \"海尔集团公司为集体所有制企业，通过海尔国际等控股平台对旗下上市公司进行实际控制。\", font_size=13, space_after=4)\n   357→add_paragraph(tf, \"关键控制链：\", font_size=14, bold=True, space_before=6, space_after=4)\n   358→add_paragraph(tf, \"海尔集团公司 → 海尔国际(51.2%) → 各业务板块\", font_size=12, font_color=HAIER_BLUE, space_after=2)\n   359→add_paragraph(tf, \"海创客(职工持股平台) → 海尔国际(48.8%，表决权委托给海尔集团)\", font_size=12, font_color=MED_GRAY, space_after=2)\n   360→\n   361→# Haier Smart Home shareholder structure\n   362→add_text_box(slide, Inches(7), Inches(1.4), Inches(5.5), Inches(0.5),\n   363→    \"海尔智家十大股东（2025）\", font_size=20, font_color=DEEP_NAVY, bold=True)\n   364→add_shape(slide, Inches(7), Inches(1.9), Inches(1.5), Inches(0.03), ACCENT_ORANGE)\n   365→\n   366→# Table\n   367→table_data = [\n   368→    [\"股东名称\", \"持股比例\", \"性质\"],\n   369→    [\"HKSCC NOMINEES LIMITED\", \"24.5%\", \"港股通代持\"],\n   370→    [\"海尔卡奥斯\", \"13%\", \"集团控股平台\"],\n   371→    [\"海尔集团公司（张瑞敏）\", \"11%\", \"创始团队\"],\n   372→    [\"香港中央结算公司\", \"7%\", \"港股通\"],\n   373→    [\"HCH（海尔旗下）\", \"5%\", \"集团关联\"],\n   374→    [\"中国证券金融\", \"—\", \"国家队\"],\n   375→    [\"中国工商银行\", \"—\", \"机构\"],\n   376→    [\"中央汇金资管\", \"—\", \"国家队\"],\n   377→]\n   378→\n   379→table = slide.shapes.add_table(len(table_data), 3, Inches(7), Inches(2.15), Inches(5.5), Inches(3.2)).table\n   380→table.columns[0].width = Inches(2.8)\n   381→table.columns[1].width = Inches(1.2)\n   382→table.columns[2].width = Inches(1.5)\n   383→\n   384→for r, row_data in enumerate(table_data):\n   385→    for c, cell_text in enumerate(row_data):\n   386→        cell = table.cell(r, c)\n   387→        cell.text = cell_text\n   388→        for paragraph in cell.text_frame.paragraphs:\n   389→            paragraph.font.size = Pt(11)\n   390→            paragraph.font.name = \"Microsoft YaHei\"\n   391→            paragraph.font.color.rgb = WHITE if r == 0 else DARK_GRAY\n   392→            paragraph.font.bold = (r == 0)\n   393→            paragraph.alignment = PP_ALIGN.CENTER if c > 0 else PP_ALIGN.LEFT\n   394→        if r == 0:\n   395→            cell.fill.solid()\n   396→            cell.fill.fore_color.rgb = DEEP_NAVY\n   397→        else:\n   398→            cell.fill.solid()\n   399→            cell.fill.fore_color.rgb = LIGHT_GRAY if r % 2 == 0 else WHITE\n   400→\n   401→# Bottom note\n   402→add_card(slide, Inches(0.8), Inches(4.5), Inches(11.7), Inches(2.5), LIGHT_GRAY)\n   403→add_text_box(slide, Inches(1), Inches(4.6), Inches(11), Inches(0.4),\n   404→    \"海尔资本结构核心特征\", font_size=18, font_color=DEEP_NAVY, bold=True)\n   405→\n   406→features = [\n   407→    \"集体所有制性质：海尔集团非民营控股也非国有独资，属于集体所有制企业，这一独特性质使其兼具市场化灵活性与公共属性\",\n   408→    \"职工持股平台（海创客）：由张