s(1.2), Inches(0.3),\n   725→        date, font_size=13, font_color=color, bold=True)\n   726→    # Title\n   727→    add_text_box(slide, Inches(3.2), Inches(y + 0.05), Inches(3), Inches(0.3),\n   728→        title, font_size=15, font_color=DEEP_NAVY, bold=True)\n   729→    # Desc\n   730→    add_text_box(slide, Inches(3.2), Inches(y + 0.38), Inches(9), Inches(0.4),\n   731→        desc, font_size=10, font_color=MED_GRAY)\n   732→\n   733→# Summary\n   734→add_card(slide, Inches(1.8), Inches(7.0), Inches(10.8), Inches(0.0), CARD_WHITE)\n   735→\n   736→# ============================================\n   737→# SLIDE 11: 资本平台与激励机制\n   738→# ============================================\n   739→slide = prs.slides.add_slide(prs.slide_layouts[6])  # Blank layout\n   740→add_bg(slide, WHITE)\n   741→add_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n   742→\n   743→add_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\n   744→add_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n   745→    \"07  资本平台与激励机制\", font_size=30, font_color=WHITE, bold=True)\n   746→\n   747→# Haier International\n   748→add_text_box(slide, Inches(0.8), Inches(1.4), Inches(10), Inches(0.5),\n   749→    \"海尔国际 — 资本运作核心平台\", font_size=22, font_color=DEEP_NAVY, bold=True)\n   750→add_shape(slide, Inches(0.8), Inches(1.9), Inches(1.5), Inches(0.03), HAIER_BLUE)\n   751→\n   752→add_card(slide, Inches(0.8), Inches(2.1), Inches(5.5), Inches(2.2), CARD_WHITE)\n   753→add_text_box(slide, Inches(1), Inches(2.2), Inches(5), Inches(0.3),\n   754→    \"海尔电器国际股份有限公司\", font_size=17, font_color=DEEP_NAVY, bold=True)\n   755→\n   756→tf = add_rich_text_box(slide, Inches(1), Inches(2.55), Inches(5), Inches(1.6))\n   757→items = [\n   758→    \"前身为青岛海尔洗衣机股份公司（1997年更名）\",\n   759→    \"海尔集团公司持股51.2%，海创客持股48.8%\",\n   760→    \"持有非白电业务主要资产：生物医疗、日日顺物流等\",\n   761→    \"海创客已将全部表决权委托给海尔集团行使\",\n   762→    \"是海尔资本运作主体，控股多家上市公司\",\n   763→    \"通过全资子公