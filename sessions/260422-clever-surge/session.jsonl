nt = PP_ALIGN.CENTER\n   802→\n   803→# Subsidiaries\n   804→subs = [(\"海尔生物医疗控股\", \"→ 海尔生物\"), (\"盈康双生(重庆)\", \"→ 盈康生命\"), (\"日日顺物流\", \"物流板块\")]\n   805→for i, (sub, arrow) in enumerate(subs):\n   806→    x = 7.1 + i * 1.9\n   807→    add_shape(slide, Inches(x + 0.7), Inches(3.93), Inches(0.03), Inches(0.2), MED_GRAY)\n   808→    sc = add_rounded_rect(slide, Inches(x), Inches(4.15), Inches(1.7), Inches(0.35), LIGHT_BLUE)\n   809→    sc.text_frame.paragraphs[0].text = sub\n   810→    sc.text_frame.paragraphs[0].font.size = Pt(10)\n   811→    sc.text_frame.paragraphs[0].font.color.rgb = DEEP_NAVY\n   812→    sc.text_frame.paragraphs[0].font.bold = True\n   813→    sc.text_frame.paragraphs[0].font.name = \"Microsoft YaHei\"\n   814→    sc.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER\n   815→\n   816→# Employee incentive\n   817→add_text_box(slide, Inches(0.8), Inches(4.7), Inches(10), Inches(0.5),\n   818→    \"海创客 — 全员持股激励平台\", font_size=22, font_color=DEEP_NAVY, bold=True)\n   819→add_shape(slide, Inches(0.8), Inches(5.2), Inches(1.5), Inches(0.03), ACCENT_ORANGE)\n   820→\n   821→add_card(slide, Inches(0.8), Inches(5.35), Inches(11.7), Inches(1.6), LIGHT_GRAY)\n   822→\n   823→tf = add_rich_text_box(slide, Inches(1), Inches(5.45), Inches(11), Inches(1.4))\n   824→add_paragraph(tf, \"海创客（青岛海创客管理咨询企业）\", font_size=15, font_color=DEEP_NAVY, bold=True, space_after=4)\n   825→add_paragraph(tf, \"海创客由海尔内部职工持股会变更而来，是海尔全员持股的核心激励平台。由张瑞敏等67名高管合伙人带领组建，持有海尔国际48.8%的股权，但已将所持有股权对应的全部表决权委托给海尔集团行使。\", font_size=12, space_after=4)\n   826→add_paragraph(tf, \"创客激励体系：\", font_size=13, font_color=HAIER_BLUE, bold=True, space_before=4, space_after=4)\n   827→add_paragraph(tf, \"海创睿等创客激励平台持有海尔生物等上市公司股权，形成'集团—创客平台—上市公司'的股权激励闭环，充分激发内部创新动力。\", font_size=12)\n   828→\n   829→# ============================================\n   830→# SLIDE 12: END\n   831→# ============================================\n   832→slide = prs.slides.add_slide(prs.slide_layouts[6])  # Blank layout\n   833→add_bg(slide, DEEP_NAVY)\n   834→add_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n   835→\n   836→add_shape(slide, Inches(1.5), Inches(2.0), Inches(2), Inches(0.04), HAIER_BLUE)\n   837→\n   838→add_text_box(slide, Inches(1.5), Inches(2.3), Inches(9), Inches(1),\n   839→    \"感谢观看\", font_size=44, font_color=WHITE, bold=True)\n   840→\n   841→add_text_box(slide, Inches(1.5), Inches(3.4), Inches(9), Inches(0.8),\n   842→    \"海尔集团 · 资本组成与关联公司全景\", font_size=22, font_color=LIGHT_BLUE)\n   843→\n   844→add_text_box(slide, Inches(1.5), Inches(4.2), Inches(9), Inches(0.5),\n   845→    \"数据来源：公开信息整理，仅供参考，不构成投资建议\", font_size=12, font_color=MED_GRAY)\n   846→\n   847→add_shape(slide, Inches(1.5), Inches(5.0), Inches(2), Inches(0.03), ACCENT_ORANGE)\n   848→\n   849→# Key summary\n   850→summary_items = [\n   851→    \"8家上市公司 · 总市值超3500亿元\",\n   852→    \"7大全球化品牌 · 连续15年全球第一\",\n   853→    \"4大核心业务板块 · 智慧住居/大健康/工业互联网/汽车生态\",\n   854→]\n   855→for i, item in enumerate(summary_items):\n   856→    add_text_box(slide, Inches(1.5), Inches(5.3 + i * 0.4), Inches(10), Inches(0.35),\n   857→        item, font_size=14, font_color=LIGHT_BLUE)\n   858→\n   859→# Save\n   860→output_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"海尔资本组成与关联公司.pptx\")\n   861→prs.save(output_path)\n   862→print(f\"PPT saved to: {output_path}\")\n   863→","toolStatus":"completed","toolDisplayMeta":{"displayName":"读取","category":"native"},"isError":false,"turnId":"msg_d6809ff4-4280-45dc-803a-bb4884b1ee4f"}
