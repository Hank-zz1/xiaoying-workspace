reholder structure\n   362→add_text_box(slide, Inches(7), Inches(1.4), Inches(5.5), Inches(0.5),\n   363→    \"海尔智家十大股东（2025）\", font_size=20, font_color=DEEP_NAVY, bold=True)\n   364→add_shape(slide, Inches(7), Inches(1.9), Inches(1.5), Inches(0.03), ACCENT_ORANGE)\n   365→\n   366→# Table\n   367→table_data = [\n   368→    [\"股东名称\", \"持股比例\", \"性质\"],\n   369→    [\"HKSCC NOMINEES LIMITED\", \"24.5%\", \"港股通代持\"],\n   370→    [\"海尔卡奥斯\", \"13%\", \"集团控股平台\"],\n   371→    [\"海尔集团公司（张瑞敏）\", \"11%\", \"创始团队\"],\n   372→    [\"香港中央结算公司\", \"7%\", \"港股通\"],\n   373→    [\"HCH（海尔旗下）\", \"5%\", \"集团关联\"],\n   374→    [\"中国证券金融\", \"—\", \"国家队\"],\n   375→    [\"中国工商银行\", \"—\", \"机构\"],\n   376→    [\"中央汇金资管\", \"—\", \"国家队\"],\n   377→]\n   378→\n   379→table = slide.shapes.add_table(len(table_data), 3, Inches(7), Inches(2.15), Inches(5.5), Inches(3.2)).table\n   380→table.columns[0].width = Inches(2.8)\n   381→table.columns[1].width = Inches(1.2)\n   382→table.columns[2].width = Inches(1.5)\n   383→\n   384→for r, row_data in enumerate(table_data):\n   385→    for c, cell_text in enumerate(row_data):\n   386→        cell = table.cell(r, c)\n   387→        cell.text = cell_text\n   388→        for paragraph in cell.text_frame.paragraphs:\n   389→            paragraph.font.size = Pt(11)\n   390→            paragraph.font.name = \"Microsoft YaHei\"\n   391→            paragraph.font.color.rgb = WHITE if r == 0 else DARK_GRAY\n   392→            paragraph.font.bold = (r == 0)\n   393→            paragraph.alignment = PP_ALIGN.CENTER if c > 0 else PP_ALIGN.LEFT\n   394→        if r == 0:\n   395→            cell.fill.solid()\n   396→            cell.fill.fore_color.rgb = DEEP_NAVY\n   397→        else:\n   398→            cell.fill.solid()\n   399→            cell.fill.fore_color.rgb = LIGHT_GRAY if r % 2 == 0 else WHITE\n   400→\n   401→# Bottom note\n   402→add_card(slide, Inches(0.8), Inches(4.5), Inches(11.7), Inches(2.5), LIGHT_GRAY)\n   403→add_text_box(slide, Inches