{"id":"msg-1776825974701-oek24g","type":"tool","content":"     1→# -*- coding: utf-8 -*-\n     2→\"\"\"海尔资本组成与关联公司 PPT\"\"\"\n     3→from pptx import Presentation\n     4→from pptx.util import Inches, Pt, Emu\n     5→from pptx.dml.color import RGBColor\n     6→from pptx.enum.text import PP_ALIGN\n     7→from pptx.enum.shapes import MSO_SHAPE\n     8→import os\n     9→\n    10→prs = Presentation()\n    11→prs.slide_width = Inches(13.333)\n    12→prs.slide_height = Inches(7.5)\n    13→\n    14→# === COLORS ===\n    15→HAIER_BLUE = RGBColor(0x00, 0x66, 0xCC)\n    16→DARK_BLUE = RGBColor(0x00, 0x3D, 0x7A)\n    17→DEEP_NAVY = RGBColor(0x0A, 0x1F, 0x3F)\n    18→LIGHT_BLUE = RGBColor(0xD6, 0xE8, 0xF7)\n    19→ACCENT_ORANGE = RGBColor(0xFF, 0x8C, 0x00)\n    20→ACCENT_GREEN = RGBColor(0x00, 0x96, 0x88)\n    21→ACCENT_RED = RGBColor(0xE5, 0x3E, 0x3E)\n    22→WHITE = RGBColor(0xFF, 0xFF, 0xFF)\n    23→DARK_GRAY = RGBColor(0x33, 0x33, 0x33)\n    24→MED_GRAY = RGBColor(0x66, 0x66, 0x66)\n    25→LIGHT_GRAY = RGBColor(0xF5, 0xF7, 0xFA)\n    26→CARD_WHITE = RGBColor(0xFF, 0xFF, 0xFF)\n    27→\n    28→def add_bg(slide, color):\n    29→    bg = slide.background\n    30→    fill = bg.fill\n    31→    fill.solid()\n    32→    fill.fore_color.rgb = color\n    33→\n    34→def add_shape(slide, left, top, width, height, fill_color, line_color=None, line_width=None, shape_type=MSO_SHAPE.RECTANGLE):\n    35→    shape = slide.shapes.add_shape(shape_type, left, top, width, height)\n    36→    shape.fill.solid()\n    37→    shape.fill.fore_color.rgb = fill_color\n    38→    if line_color:\n    39→        shape.line.color.rgb = line_color\n    40→        shape.line.width = line_width or Pt(1)\n    41→    else:\n    42→        shape.line.fill.background()\n    43→    return shape\n    44→\n    45→def add_rounded_rect(slide, left, top, width, height, fill_color, line_color=None):\n    46→    shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, left, top, width, height)\n    47→    shape.fill.solid()\n    48→    shape.fill.fore_color.rgb = fill_color\n    49→    if line_color:\n    50→        shape.line.color.rgb = line_color\n    51→        shape.line.width = Pt(1)\n    52→    else:\n    53→        shape.line.fill.background()\n    54→    return shape\n    55→\n    56→def add_text_box(slide, left, top, width, height, text, font_size=14, font_color=DARK_GRAY, bold=False, font_face=\"Microsoft YaHei\", alignment=PP_ALIGN.LEFT, line_spacing=None):\n    57→    txBox = slide.shapes.add_textbox(left, top, width, height)\n    58→    tf = txBox.text_frame\n    59→    tf.word_wrap = True\n    60→    p = tf.paragraphs[0]\n    61→    p.text = text\n    62→    p.font.size = Pt(font_size)\n    63→    p.font.color.rgb = font_color\n    64→    p.font.bold = bold\n    65→    p.font.name = font_face\n    66→    p.alignment = alignment\n    67→    if line_spacing:\n    68→        p.space_after = Pt(line_spacing)\n    69→    return txBox\n    70→\n    71→def add_rich_text_box(slide, left, top, width, height):\n    72→    txBox = slide.shapes.add_textbox(left, top, width, height)\n    73→    tf = txBox.text_frame\n    74→    tf.word_wrap = True\n    75→    return tf\n    76→\n    77→def add_paragraph(tf, text, font_size=14, font_color=DARK_GRAY, bold=False, font_face=\"Microsoft YaHei\", alignment=PP_ALIGN.LEFT, space_before=0, space_after=4, break_line=True):\n    78→    if len(tf.paragraphs) == 1 and tf.paragraphs[0].text == \"\":\n    79→        p = tf.paragraphs[0]\n    80→    else:\n    81→        p = tf.add_paragraph()\n    82→    p.text = text\n    83→    p.font.size = Pt(font_size)\n    84→    p.font.color.rgb = font_color\n    85→    p.font.bold = bold\n    86→    p.font.name = font_face\n    87→    p.alignment = alignment\n    88→    p.space_before = Pt(space_before)\n    89→    p.space_after = Pt(space_after)\n    90→    return p\n    91→\n    92→def add_card(slide, left, top, width, height, fill_color=CARD_WHITE, shadow=False, border_color=None):\n    93→    shape = add_rounded_rect(slide, left, top, width, height, fill_color, border_color)\n    94→    if shadow:\n    95→        from pptx.oxml.ns import qn\n    96→        sp = shape._element\n    97→        spPr = sp.find(qn('a:spPr'))\n    98→        if spPr is None:\n    99→            spPr = sp.makeelement(qn('a:spPr'), {})\n   100→            sp.insert(0, spPr)\n   101→        effectLst = spPr.makeelement(qn('a:effectLst'), {})\n   102→        outerShdw = effectLst.makeelement(qn('a:outerShdw'), {\n   103→            'blurRad': '50800', 'dist': '38100', 'dir': '2700000',\n   104→            'algn': 'ctr', 'rotWithShape': '0'\n   105→        })\n   106→        srgbClr = outerShdw.makeelement(qn('a:srgbClr'), {'val': '000000'})\n   107→        alpha = srgbClr.makeelement(qn('a:alpha'), {'val': '12000'})\n   108→        srgbClr.append(alpha)\n   109→        outerShdw.append(srgbClr)\n   110→        effectLst.append(outerShdw)\n   111→        spPr.append(effectLst)\n   112→    return shape\n   113→\n   114→# ============================================\n   115→# SLIDE 1: TITLE\n   116→# ============================================\n   117→slide = prs.slides.add_slide(prs.slide_layouts[6])  # Blank layout\n   118→add_bg(slide, DEEP_NAVY)\n   119→\n   120→# Decorative left bar\n   121→add_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n   122→\n   123→# Top accent line\n   124→add_shape(slide, Inches(1.5), Inches(1.2), Inches(3), Inches(0.04), HAIER_BLUE)\n   125→\n   126→add_text_box(slide, Inches(1.5), Inches(1.5), Inches(9), Inches(1.2),\n   127→    \"海尔集团\", font_size=48, font_color=WHITE, bold=True, font_face=\"Microsoft YaHei\")\n   128→\n   129→add_text_box(slide, Inches(1.5), Inches(2.7), Inches(9), Inches(1.5),\n   130→    \"资本组成与关联公司全景\", font_size=36, font_color=LIGHT_BLUE, bold=False, font_face=\"Microsoft YaHei\")\n   131→\n   132→add_text_box(slide, Inches(1.5), Inches(4.5), Inches(9), Inches(0.8),\n   133→    \"HAIER GROUP — Capital Structure & Affiliated Companies\", font_size=18, font_color=MED_GRAY, font_face=\"Microsoft YaHei\")\n   134→\n   135→# Divider\n   136→add_shape(slide, Inches(1.5), Inches(5.6), Inches(2), Inches(0.03), ACCENT_ORANGE)\n   137→\n   138→add_text_box(slide, Inches(1.5), Inches(5.9), Inches(5), Inches(0.5),\n   139→    \"报告日期：2026年4月22日\", font_size=14, font_color=MED_GRAY, font_face=\"Microsoft YaHei\")\n   140→\n   141→# Right side decorative\n   142→add_shape(slide, Inches(11.5), Inches(5.5), Inches(1.5), Inches(0.04), ACCENT_ORANGE)\n   143→add_shape(slide, Inches(11.5), Inches(5.7), Inches(1), Inches(0.03), HAIER_BLUE)\n   144→\n   145→# ============================================\n   146→# SLIDE 2: 目录\n   147→# ============================================\n   148→slide = prs.slides.add_slide(prs.slide_layouts[6])  # Blank layout\n   149→add_bg(slide, LIGHT_GRAY)\n   150→add_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n   151→\n   152→add_text_box(slide, Inches(0.8), Inches(0.4), Inches(8), Inches(0.8),\n   153→    \"目录\", font_size=36, font_color=DEEP_NAVY, bold=True)\n   154→\n   155→add_shape(slide, Inches(0.8), Inches(1.3), Inches(2), Inches(0.04), HAIER_BLUE)\n   156→\n   157→toc_items = [\n   158→    (\"01\", \"集团概况\", \"海尔集团发展历程与核心业务定位\"),\n   159→    (\"02\", \"资本结构\", \"股权架构与控制关系全景\"),\n   160→    (\"03\", \"八大上市公司\", \"海尔系上市公司矩阵详解\"),\n   161→    (\"04\", \"重要关联公司\", \"控股子公司与核心业务平台\"),\n   162→    (\"05\", \"全球化品牌矩阵\", \"海尔品牌生态布局\"),\n   163→    (\"06\", \"重大并购动态\", \"近年核心资本运作事件\"),\n   164→    (\"07\", \"资本平台与激励机制\", \"海创客、海尔国际等核心平台\"),\n   165→]\n   166→\n   167→start_y = 1.7\n   168→for i, (num, title, desc) in enumerate(toc_items):\n   169→    y = start_y + i * 0.75\n   170→    # Number circle\n   171→    shape = add_shape(slide, Inches(1.2), Inches(y), Inches(0.5), Inches(0.5), HAIER_BLUE, shape_type=MSO_SHAPE.OVAL)\n   172→    tf = shape.text_frame\n   173→    tf.paragraphs[0].text = num\n   174→    tf.paragraphs[0].font.size = Pt(16)\n   175→    tf.paragraphs[0].font.color.rgb = WHITE\n   176→    tf.paragraphs[0].font.bold = True\n   177→    tf.paragraphs[0].font.name = \"Microsoft YaHei\"\n   178→    tf.paragraphs[0].alignment = PP_ALIGN.CENTER\n   179→\n   180→    add_text_box(slide, Inches(1.9), Inches(y - 0.02), Inches(4), Inches(0.35),\n   181→        title, font_size=18, font_color=DEEP_NAVY, bold=True)\n   182→    add_text_box(slide, Inches(1.9), Inches(y + 0.32), Inches(8), Inches(0.3),\n   183→        desc, font_size=11, font_color=MED_GRAY)\n   184→\n   185→# ============================================\n   186→# SLIDE 3: 集团概况\n   187→# ============================================\n   188→slide = prs.slides.add_slide(prs.slide_layouts[6])  # Blank layout\n   189→add_bg(slide, WHITE)\n   190→add_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n   191→\n   192→# Header bar\n   193→add_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\n   194→add_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n   195→    \"01  集团概况\", font_size=30, font_color=WHITE, bold=True)\n   196→\n   197→# Left column - overview\n   198→add_text_box(slide, Inches(0.8), Inches(1.5), Inches(5.5), Inches(0.5),\n   199→    \"海尔集团简介\", font_size=22, font_color=DEEP_NAVY, bold=True)\n   200→add_shape(slide, Inches(0.8), Inches(2.05), Inches(1.5), Inches(0.03), HAIER_BLUE)\n   201→\n   202→tf = add_rich_text_box(slide, Inches(0.8), Inches(2.2), Inches(5.5), Inches(2.5))\n   203→overview_text = [\n   204→    (\"海尔集团创立于1984年，总部位于山东省青岛市，\", False),\n   205→    (\"是全球领先的美好生活和数字化转型解决方案服务商。\", True),\n   206→    (\"\", False),\n   207→    (\"集团连续15年稳居欧睿国际全球大型家电品牌零售量第一名，\", False),\n   208→    (\"已从传统家电制造商转型为物联网时代的生态品牌。\", True),\n   209→]\n   210→for text, is_bold in overview_text:\n   211→    add_paragraph(tf, text, font_size=14, font_color=DARK_GRAY, bold=is_bold, space_after=2)\n   212→\n   213→# Right side - key stats\n   214→add_text_box(slide, Inches(7), Inches(1.5), Inches(5.5), Inches(0.5),\n   215→    \"核心数据\", font_size=22, font_color=DEEP_NAVY, bold=True)\n   216→add_shape(slide, Inches(7), Inches(2.05), Inches(1.5), Inches(0.03), ACCENT_ORANGE)\n   217→\n   218→stats = [\n   219→    (\"3,023亿\", \"海尔智家2025年营收\", \"首次突破3000亿元\"),\n   220→    (\"195.5亿\", \"归母净利润\", \"同比增长4.39%\"),\n   221→    (\"8家\", \"旗下上市公司数量\", \"总市值超3500亿元\"),\n   222→    (\"7大\", \"全球化高端品牌\", \"海尔/卡萨帝/Leader/GEA等\"),\n   223→    (\"1984年\", \"创立年份\", \"总部位于山东青岛\"),\n   224→]\n   225→\n   226→for i, (val, label, note) in enumerate(stats):\n   227→    y = 2.3 + i * 0.85\n   228→    # Card\n   229→    add_card(slide, Inches(7), Inches(y), Inches(5.5), Inches(0.72), CARD_WHITE)\n   230→    # Accent bar\n   231→    add_shape(slide, Inches(7), Inches(y), Inches(0.06), Inches(0.72), HAIER_BLUE)\n   232→    # Value\n   233→    add_text_box(slide, Inches(7.25), Inches(y + 0.05), Inches(1.8), Inches(0.4),\n   234→        val, font_size=22, font_color=HAIER_BLUE, bold=True)\n   235→    # Label\n   236→    add_text_box(slide, Inches(9.2), Inches(y + 0.05), Inches(3), Inches(0.35),\n   237→        label, font_size=13, font_color=DEEP_NAVY, bold=True)\n   238→    # Note\n   239→    add_text_box(slide, Inches(9.2), Inches(y + 0.38), Inches(3), Inches(0.3),\n   240→        note, font_size=10, font_color=MED_GRAY)\n   241→\n   242→# Bottom section - business segments\n   243→add_text_box(slide, Inches(0.8), Inches(5.0), Inches(10), Inches(0.5),\n   244→    \"核心业务板块\", font_size=20, font_color=DEEP_NAVY, bold=True)\n   245→\n   246→biz_segs = [\n   247→    (\"智慧住居\", \"海尔智家为主体，覆盖冰箱、洗衣机、空调等全品类家电\", HAIER_BLUE),\n   248→    (\"大健康产业\", \"盈康一生生态，涵盖医疗设备、医疗服务、生物制品\", ACCENT_GREEN),\n   249→    (\"工业互联网\", \"卡奥斯COSMOPlat平台，赋能制造业数字化转型\", ACCENT_ORANGE),\n   250→    (\"汽车生态\", \"卡泰驰+汽车之家，布局家车互联与汽车互联网\", ACCENT_RED),\n   251→]\n   252→\n   253→for i, (title, desc, color) in enumerate(biz_segs):\n   254→    x = 0.8 + i * 3.05\n   255→    # Card\n   256→    add_card(slide, Inches(x), Inches(5.55), Inches(2.8), Inches(1.4), CARD_WHITE)\n   257→    # Top color bar\n   258→    add_shape(slide, Inches(x), Inches(5.55), Inches(2.8), Inches(0.06), color)\n   259→    add_text_box(slide, Inches(x + 0.2), Inches(5.7), Inches(2.4), Inches(0.4),\n   260→        title, font_size=16, font_color=DEEP_NAVY, bold=True)\n   261→    add_text_box(slide, Inches(x + 0.2), Inches(6.1), Inches(2.4), Inches(0.8),\n   262→        desc, font_size=11, font_color=MED_GRAY)\n   263→\n   264→# ============================================\n   265→# SLIDE 4: 资本结构总览\n   266→# ============================================\n   267→slide = prs.slides.add_slide(prs.slide_layouts[6])  # Blank layout\n   268→add_bg(slide, LIGHT_GRAY)\n   269→add_shape(slide, Inches(0), Inches(0), Inches(0.15), Inches(7.5), HAIER_BLUE)\n   270→\n   271→add_shape(slide, Inches(0), Inches(0), Inches(13.333), Inches(1.1), DEEP_NAVY)\n   272→add_text_box(slide, Inches(0.8), Inches(0.25), Inches(10), Inches(0.6),\n   273→    \"02  资本结构总览\", font_size=30, font_color=WHITE, bold=True)\n   274→\n   275→# Core structure: Haier Group\n   276→add_card(slide, Inches(4.5), Inches(1.5), Inches(4.3), Inches(0.8), HAIER_BLUE)\n   277→add_text_box(slide, Inches(4.6), Inches(1.55), Inches(4.1), Inches(0.35),\n   278→    \"海尔集团公司（实控人）\", font_size=18, font_color=WHITE, bold=True, alignment=PP_ALIGN.CENTER)\n   279→add_text_box(slide, Inches(4.6), Inches(1.9), Inches(4.1), Inches(0.3),\n   280→    \"集体所有制企业 · 核心控制中枢\", font_size=11, font_color=LIGHT_BLUE, alignment=PP_ALIGN.CENTER)\n   281→\n   282→# Arrow down\n   283→add_shape(slide, Inches(6.4), Inches(2.35), Inches(0.06), Inches(0.4), MED_GRAY)\n   284→\n   285→# Haier International\n   286→add_card(slide, Inches(3), Inches(2.8), Inches(7.3), Inches(0.7), CARD_WHITE, border_color=HAIER_BLUE)\n   287→add_text_box(slide, Inches(3.2), Inches(2.85), Inches(3), Inches(0.3),\n   288→    \"海尔电器国际股份有限公司\", font_size=15, font_color=DEEP_NAVY, bold=True)\n   289→add_text_box(slide, Inches(6.5), Inches(2.85), Inches(3.5), Inches(0.3),\n   290→    \"集团持股51.2% + 海创客48.8%\", font_size=12, font_color=MED_GRAY)\n   291→\n   292→# Arrow down\n   293→add_shape(slide, Inches(6.4), Inches(3.55), Inches(0.06), Inches(0.35), MED_GRAY)\n   294→\n   295→# Two pillars\n   296→add_text_box(slide, Inches(0.5), Inches(4.1), Inches(12), Inches(0.5),\n   297→    \"海尔系八大上市公司矩阵\", font_size=22, font_color=DEEP_NAVY, bold=True)\n   298→\n   299→# Listed companies in grid\n   300→companies = [\n   301→    (\"海尔智家\", \"600690.SH / 06690.HK\", \"智慧住居·家电\", \"3023亿营收\", HAIER_BLUE),\n   302→    (\"海尔生物\", \"688139.SH\", \"生物医疗低温存储\", \"科创板上市\", ACCENT_GREEN),\n   303→    (\"盈康生命\", \"300143.SZ\", \"医疗服务·肿瘤专科\", \"大健康生态\", ACCENT_RED),\n   304→    (\"上海莱士\", \"002252.SZ\", \"血液制品\", \"血王\", ACCENT_ORANGE),\n   305→    (\"雷神科技\", \"872190.BJ\", \"电竞硬件·笔记本\", \"北交所上市\", HAIER_BLUE),\n   306→    (\"新时达\", \"002527.SZ\", \"工业机器人\", \"卡奥斯控股\", DEEP_NAVY),\n   307→    (\"汽车之家\", \"02518.HK\", \"汽车互联网平台\", \"卡泰驰控股\", ACCENT_RED),\n   308→    (\"众淼控股\", \"A股\", \"综合控股平台\", \"海尔系成员\", MED_GRAY),\n   309→]\n   310→\n   311→for i, (name, code, biz, tag, color) in enumerate(companies):\n   312→    col = i % 4\n   313→    row = i // 4\n   314→    x = 0.5 + col * 3.15\n   315→    y = 4.7 + row * 1.35\n   316→\n   317→    add_card(slide, Inches(x), Inches(y), Inches(2.95), Inches(1.15), CARD_WHITE)\n   318→    # Left accent\n   319→    add_shape(slide, Inches(x), Inches(y), Inches(0.06), Inches(1.15), color)\n   320→    # Name\n   321→    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.08), Inches(2.5), Inches(0.3),\n   322→        name, font_size=16, font_color=DEEP_NAVY, bold=True)\n   323→    # Code\n   324→    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.38), Inches(2.5), Inches(0.25),\n   325→        code, font_size=10, font_color=MED_GRAY)\n   326→    # Biz\n   327→    add_text_box(slide, Inches(x + 0.2), Inches(y + 0.6), Inc