        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83c\uddf7\ud83c\uddfa \u666e\u4eac\u62b5\u8fbe\u5317\u4eac\u5f00\u542f\u7b2c25\u6b21\u8bbf\u534e**\n\u5e94\u4e60\u8fd1\u5e73\u4e3b\u5e2d\u9080\u8bf7\uff0c\u4fc4\u7f57\u65af\u603b\u7edf\u666e\u4eac5\u670819\u65e5\u665a\u62b5\u8fbe\u5317\u4eac\uff0c\u4e2d\u4fc4\u5143\u9996\u5c06\u5c31\u53cc\u8fb9\u5173\u7cfb\u53ca\u56fd\u9645\u5730\u533a\u95ee\u9898\u4ea4\u6362\u610f\u89c1\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83c\udfdb\ufe0f \u674e\u5f3a\u7b7e\u7f72\u56fd\u52a1\u9662\u4ee4\u4fee\u8ba2\u300a\u884c\u653f\u6cd5\u89c4\u5236\u5b9a\u7a0b\u5e8f\u6761\u4f8b\u300b**\n\u4fee\u8ba2\u540e\u6761\u4f8b\u5c06\u4e8e2026\u5e747\u67081\u65e5\u8d77\u65bd\u884c\uff0c\u8fdb\u4e00\u6b65\u5b8c\u5584\u884c\u653f\u6cd5\u89c4\u5236\u5b9a\u7a0b\u5e8f\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83c\udf3f \u957f\u6c5f\u7ecf\u6d4e\u5e26\u9ad8\u8d28\u91cf\u53d1\u5c55\u6301\u7eed\u63a8\u8fdb**\n\u6cbf\u6c5f11\u7701\u5e02\u8df5\u884c\u201c\u5171\u6293\u5927\u4fdd\u62a4\u3001\u4e0d\u641e\u5927\u5f00\u53d1\u201d\uff0c4\u6708\u88c5\u5907\u5236\u9020\u3001\u9ad8\u6280\u672f\u5236\u9020\u4e1a\u5feb\u901f\u589e\u957f\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udef0\ufe0f \u4e2d\u6b27\u8054\u5408\u7814\u5236\u201c\u5fae\u7b11\u201d\u536b\u661f\u6210\u529f\u53d1\u5c04**\n\u592a\u9633\u98ce-\u78c1\u5c42\u76f8\u4e92\u4f5c\u7528\u5168\u666f\u6210\u50cf\u536b\u661f\u4ece\u6cd5\u5c5e\u572d\u4e9a\u90a3\u53d1\u5c04\u5347\u7a7a\uff0c\u987a\u5229\u8fdb\u5165\u9884\u5b9a\u8f68\u9053\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\u26bd \u4e2d\u56fdU17\u7537\u8db3\u95ef\u5165\u4e9a\u6d32\u676f\u51b3\u8d5b**\n\u4e2d\u56fd\u961f2:0\u6218\u80dc\u6fb3\u5927\u5229\u4e9a\uff0c\u65f6\u969422\u5e74\u518d\u6b21\u95ef\u5165U17\u4e9a\u6d32\u676f\u51b3\u8d5b\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83c\uddee\ud83c\uddf7 \u4f0a\u6717\u5c40\u52bf\u6301\u7eed\u7d27\u5f20**\n\u7279\u6717\u666e\u79f0\u53ef\u80fd\u518d\u7ed9\u4f0a\u6717\u201c\u731b\u70c8\u4e00\u51fb\u201d\uff1b\u7f8e\u526f\u603b\u7edf\u4e07\u65af\u8868\u793a\u5df2\u51c6\u5907\u201cB\u65b9\u6848\u201d\u519b\u4e8b\u9009\u9879\uff1b\u4ee5\u8272\u5217\u8bc4\u4f30\u8ba4\u4e3a\u7f8e\u65b9\u4ecd\u503e\u5411\u52a8\u6b66\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83c\uddef\ud83c\uddf5 \u65e5\u672c\u4e07\u4eba\u96c6\u4f1a\u6297\u8bae\u9ad8\u5e02\u653f\u5e9c\u4fee\u5baa\u6269\u519b**\n\u6c11\u4f17\u5728\u56fd\u4f1a\u8bae\u4e8b\u5802\u524d\u96c6\u4f1a\uff0c\u53cd\u5bf9\u9ad8\u5e02\u65e9\u82d7\u653f\u5e9c\u7834\u574f\u548c\u5e73\u5baa\u6cd5\u53ca\u6269\u519b\u5907\u6b66\u52a8\u5411\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83e\udda0 \u521a\u679c(\u91d1)\u66b4\u53d1\u7f55\u89c1\u57c3\u535a\u62c9\u6bd2\u682a\u75ab\u60c5**\n\u672c\u8fea\u5e03\u7126\u578b\u75c5\u6bd2\u5c1a\u65e0\u83b7\u6279\u836f\u7269\u6216\u75ab\u82d7\uff0c\u9632\u63a7\u96be\u5ea6\u52a0\u5927\uff1b\u5370\u5ea6\u591a\u5730\u6c14\u6e29\u8d85\u0034\u0035\u00b0\u0043\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83e\udd16 \u73b0\u4ee3\u6c7d\u8f66\u5ba3\u5e03\u90e8\u7f72\u0032\u002e\u0035\u4e07\u53f0\u0041\u0074\u006c\u0061\u0073\u4eba\u5f62\u673a\u5668\u4eba**\n\u76ee\u68072028\u5e74\u5b9e\u73b0\u5e74\u4ea7\u0033\u4e07\u53f0\uff0c\u5c06\u5728\u73b0\u4ee3\u548c\u8d77\u4e9a\u751f\u4ea7\u57fa\u5730\u5927\u89c4\u6a21\u90e8\u7f72\u3002"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83e\udde0 \u8c37\u6b4c\u0049\u002f\u004f \u0032\u0030\u0032\u0036\uff1a\u0041\u0049\u641c\u7d22\u5168\u9762\u5347\u7ea7**\n\u8c37\u6b4c\u91cd\u65b0\u8bbe\u8ba1\u641c\u7d22\u6846\uff0c\u53d1\u5e03\u0041\u0049\u7f16\u7a0b\u5de5\u5177\uff1b\u0041\u0049 \u0053\u0074\u0075\u0064\u0069\u006f\u652f\u6301\u6587\u672c\u751f\u6210\u539f\u751f\u5b89\u5353\u5e94\u7528\u3002"}
      },
      {"tag": "hr"},
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udccc \u4e8c\u3001\u5404\u5e73\u53f0\u70ed\u641c \u0054\u006f\u0070 \u0035**"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udd35 \u5fae\u535a\u70ed\u641c**\n\u0031\u002e \u666e\u4eac\u8bbf\u534e\u00b7\u7b2c\u0032\u0035\u6b21\u56fd\u4e8b\u8bbf\u95ee [\u65f6\u653f]\n\u0032\u002e \u0035\u0032\u0030\u5168\u6c11\u8868\u767d\u65e5\u00b7\u5404\u5730\u6c11\u653f\u5c40\u201c\u5185\u5377\u201d [\u793e\u4f1a]\n\u0033\u002e \u5b5f\u5b50\u4e49\u786e\u8ba4\u52a0\u76df\u300a\u5954\u8dd1\u5427\u300b [\u5a31\u4e50]\n\u0034\u002e \u201c\u5f90\u82e5\u6657\u6ca1\u6709\u7406\u65b9\u5a9b\u201d\u5f15\u793e\u4ea4\u70ed\u8bae [\u7efc\u827a]\n\u0035\u002e \u738b\u8005\u8363\u8000\u0035\u0032\u0030\u65b0\u76ae\u80a4 \u6700\u4f4e\u0036\u0030\u70b9\u5238 [\u6e38\u620f]"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udd34 \u767e\u5ea6\u70ed\u641c**\n\u0031\u002e \u4e2d\u7f8e\u5143\u9996\u5317\u4eac\u4f1a\u665e\u540e\u7eed\u5f71\u54cd [\u65f6\u653f]\n\u0032\u002e \u7b2c\u4e8c\u8258\u56fd\u4ea7\u5927\u578b\u90ae\u8f6e\u201c\u7231\u8fbe\u00b7\u82b1\u57ce\u53f7\u201d\u552e\u7968 [\u793e\u4f1a]\n\u0033\u002e \u0032\u0030\u0032\u0036\u8c37\u6b4c\u0049\u002f\u004f\u5927\u4f1a \u0041\u0049\u641c\u7d22\u91cd\u5927\u66f4\u65b0 [\u79d1\u6280]\n\u0034\u002e \u5357\u65b9\u66b4\u96e8\u53e0\u52a0\u5e7f\u897f\u67f3\u5dde\u0035\u002e\u0032\u7ea7\u5730\u9707 [\u793e\u4f1a]\n\u0035\u002e \u0034\u6708\u4efd\u5236\u9020\u4e1a\u65b0\u52a8\u80fd\u6301\u7eed\u589e\u5f3a [\u8d22\u7ecf]"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83c\udfb5 \u6296\u97f3\u70ed\u70b9**\n\u0031\u002e \u0035\u0032\u0030\u544a\u767d\u5b63\u00b7\u751c\u871c\u7ecf\u6d4e\u5168\u57ce\u5347\u6e29 [\u793e\u4f1a]\n\u0032\u002e \u004e\u0042\u0041\u897f\u90e8\u51b3\u8d5b\u96f7\u9706\u0076\u0073\u9a6c\u523a\u5f00\u6218 [\u4f53\u80b2]\n\u0033\u002e \u4e2d\u56fd\u0055\u0031\u0037\u7537\u8db3\u0032\u002d\u0030\u6fb3\u5927\u5229\u4e9a\u95ef\u5165\u4e9a\u6d32\u676f\u51b3\u8d5b [\u4f53\u80b2]\n\u0034\u002e \u6210\u90fd\u0032\u0033\u533a(\u5e02)\u53bf\u8054\u52a8\u0035\u0032\u0030\u96c6\u4f53\u5a5a\u793c [\u793e\u4f1a]\n\u0035\u002e \u5404\u5730\u7279\u8272\u201c\u0035\u0032\u0030\u201d\u6253\u5361\u5730\u624e\u5806\u4eae\u76f8 [\u751f\u6d3b]"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udcac \u77e5\u4e4e\u70ed\u699c**\n\u0031\u002e \u666e\u4eac\u7b2c\u0032\u0035\u6b21\u8bbf\u534e\uff0c\u4e2d\u4fc4\u5173\u7cfb\u5c06\u8fce\u6765\u54ea\u4e9b\u65b0\u7a81\u7834\uff1f [\u65f6\u653f]\n\u0032\u002e \u7279\u6717\u666e\u53d6\u6d88\u5bf9\u4f0a\u7a7a\u88ad\u540e\u53c8\u5a01\u80c1\u201c\u731b\u70c8\u4e00\u51fb\u201d\uff0c\u5c40\u52bf\u5c06\u5982\u4f55\u53d1\u5c55\uff1f [\u56fd\u9645]\n\u0033\u002e \u521a\u679c(\u91d1)\u66b4\u53d1\u7f55\u89c1\u57c3\u535a\u62c9\u6bd2\u682a\u75ab\u60c5\uff0c\u5168\u7403\u9632\u63a7\u9762\u4e34\u54ea\u4e9b\u6311\u6218\uff1f [\u79d1\u5b66]\n\u0034\u002e \u8c37\u6b4c\u0049\u002f\u004f\u53d1\u5e03\u0041\u0049\u641c\u7d22\u5347\u7ea7\uff0c\u4f20\u7edf\u641c\u7d22\u5f15\u64ce\u4f1a\u88ab\u98a0\u8986\u5417\uff1f [\u79d1\u6280]\n\u0035\u002e \u0035\u0032\u0030\u201c\u751c\u871c\u7ecf\u6d4e\u201d\u706b\u7206\uff0c\u5982\u4f55\u770b\u5f85\u6d88\u8d39\u4e3b\u4e49\u5bf9\u60c5\u611f\u8868\u8fbe\u7684\u88f9\u631f\uff1f [\u793e\u4f1a]"}
      },
      {"tag": "hr"},
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udccc \u4e09\u3001\u8de8\u5e73\u53f0\u70ed\u70b9 \ud83d\udd25**"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udd25 \u666e\u4eac\u8bbf\u534e\u00b7\u4e2d\u4fc4\u5173\u7cfb\u65b0\u7bc7\u7ae0**\n\u8986\u76d6\uff1a\u5fae\u535a/\u767e\u5ea6/\u77e5\u4e4e/\u6296\u97f3 \u2014 \u666e\u4eac\u7b2c\u0032\u0035\u6b21\u8bbf\u534e\uff0c\u4e2d\u4fc4\u4e24\u56fd\u5143\u9996\u5c06\u5c31\u53cc\u8fb9\u5173\u7cfb\u53ca\u56fd\u9645\u5730\u533a\u95ee\u9898\u6df1\u5165\u4ea4\u6362\u610f\u89c1\uff0c\u4fc4\u7f57\u65af\u5404\u754c\u9ad8\u5ea6\u671f\u5f85\u3002 [\u65f6\u653f]"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udd25 \u0035\u0032\u0030\u201c\u751c\u871c\u7ecf\u6d4e\u201d\u5168\u57ce\u5347\u6e29**\n\u8986\u76d6\uff1a\u5fae\u535a/\u6296\u97f3/\u767e\u5ea6/\u77e5\u4e4e \u2014 \u6210\u90fd\u3001\u9752\u5c9b\u3001\u6d4e\u5357\u7b49\u5730\u63a8\u51fa\u96c6\u4f53\u5a5a\u793c\u3001\u5564\u9152\u4e3b\u9898\u5a5a\u59fb\u767b\u8bb0\u70b9\u7b49\u7279\u8272\u670d\u52a1\uff0c\u201c\u6d6a\u6f2b\u6d88\u8d39\u201d\u6210\u4e3a\u65b0\u70ed\u70b9\u3002 [\u793e\u4f1a]"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udd25 \u7f8e\u4f0a\u5c40\u52bf\u6301\u7eed\u7ef7\u7d27**\n\u8986\u76d6\uff1a\u767e\u5ea6/\u77e5\u4e4e/\u5fae\u535a \u2014 \u7279\u6717\u666e\u79f0\u53ef\u80fd\u201c\u518d\u7ed9\u4f0a\u6717\u731b\u70c8\u4e00\u51fb\u201d\uff0c\u4e07\u65af\u900f\u9732\u5df2\u51c6\u5907\u0042\u65b9\u6848\uff0c\u4ee5\u8272\u5217\u8bc4\u4f30\u7f8e\u65b9\u4ecd\u503e\u5411\u91cd\u542f\u519b\u4e8b\u884c\u52a8\u3002 [\u56fd\u9645]"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udd25 \u8c37\u6b4c\u0049\u002f\u004f \u0032\u0030\u0032\u0036 \u00b7 \u0041\u0049\u65b0\u65f6\u4ee3**\n\u8986\u76d6\uff1a\u767e\u5ea6/\u77e5\u4e4e/\u5fae\u535a \u2014 \u8c37\u6b4c\u91cd\u65b0\u8bbe\u8ba1\u0041\u0049\u641c\u7d22\u6846\u3001\u53d1\u5e03\u0041\u0049\u7f16\u7a0b\u5de5\u5177\u3001\u0041\u0049 \u0053\u0074\u0075\u0064\u0069\u006f\u53ef\u751f\u6210\u539f\u751f\u5b89\u5353\u5e94\u7528\uff0c\u5f15\u53d1\u79d1\u6280\u5708\u5e7f\u6cdb\u8ba8\u8bba\u3002 [\u79d1\u6280]"}
      },
      {
        "tag": "div",
        "text": {"tag": "lark_md", "content": "**\ud83d\udd25 \u4e2d\u6b27\u8054\u5408\u201c\u5fae\u7b11\u201d\u536b\u661f\u6210\u529f\u53d1\u5c04**\n\u8986\u76d6\uff1a\u767e\u5ea6/\u77e5\u4e4e/\u5fae\u535a \u2014 \u592a\u9633\u98ce-\u78c1\u5c42\u76f8\u4e92\u4f5c\u7528\u5168\u666f\u6210\u50cf\u536b\u661f\u987a\u5229\u5165\u8f68\uff0c\u4e2d\u6b27\u822a\u5929\u5408\u4f5c\u518d\u7ed3\u7855\u679c\u3002 [\u79d1\u6280]"}
      }
    ],
    "note": {
      "tag": "plain_text",
      "content": "\u7531 Incaier Agent \u81ea\u52a8\u751f\u6210 \u00b7 2026\u5e745\u670820\u65e5"
    }
  }
